data_임시/*/fixture/*
!data_임시/*/fixture/.gitkeep
data_임시/*/law/*
!data_임시/*/law/.gitkeep
*.zip

# V4 대조 데이터 (데이터팀 전달본 · issue #198). 원본 60MB+ 라 저장소에 올리지 않는다.
data_임시/_v4/

# 공공 데이터, 캐시
data_임시/region_data/*
!data_임시/region_data/.gitkeep
data_임시/search_cache/*
!data_임시/search_cache/.gitkeep

# 산출물
data_임시/step1_output/*
!data_임시/step1_output/.gitkeep
data_임시/step2_output/*
!data_임시/step2_output/.gitkeep
data_임시/step3_output/*
!data_임시/step3_output/.gitkeep
data_임시/step4_output/*
