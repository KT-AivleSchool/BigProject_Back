# ==============================================================================
# OmniSite — 환경변수 명세 (.env.example)
# ==============================================================================
# 사용법:
#   1) 이 파일을 복사해 같은 폴더에 ".env" 로 저장
#   2) 아래 값을 본인 키로 채움
#   3) .env 는 절대 git 에 올리지 말 것 (.gitignore 에 포함)
#
# 갱신 2026-08-05 — 파이프라인(STEP0~4)이 읽는 키 3개가 빠져 있었고
#                   브이월드 키는 이름이 하나 어긋나 있었다. 아래 🔴 참조.
#
# 모델명·타임아웃 등 비밀이 아닌 설정은 app/config.py 에 있다. 여기 넣지 않는다.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 서버 기본
# ------------------------------------------------------------------------------
PROJECT_NAME="OmniSite FastAPI Monolith"
API_V1_STR="/api/v1"


# ------------------------------------------------------------------------------
# 2. 데이터베이스 (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
# 형식: postgresql://[사용자]:[비밀번호]@[호스트]:[포트]/[DB명]
#
# 📌 /api/v1/pipeline/* (화면 1~4) 는 DB 없이 돈다 — 파이프라인은 파일로만 주고받는다.
#    다만 /api/v1/auth/register · /auth/login 은 요청마다 DB 를 친다.
#    인증까지 만져 보려면 Postgres 가 필요하다.
#
# 🔴 2026-08-07 침해 사고. 비밀번호가 `postgres` 이고 컨테이너 포트가 0.0.0.0 이라
#    외부 봇이 무차별 대입으로 뚫고 DB 를 통째로 DROP 했다(랜섬 노트 삽입).
#    - 비밀번호는 각자 무작위로 만든다. **여기 예시값을 그대로 쓰지 말 것.**
#      생성: python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
#    - docker-compose 는 127.0.0.1 에만 바인딩한다(수정됨). 포트를 다시 열지 말 것.
#    - POSTGRES_PASSWORD / REDIS_PASSWORD 는 compose 가 읽는다. 없으면 기동이 실패한다.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
#
# 🔴 호스트는 `localhost` 가 아니라 **`127.0.0.1`** 이다(2026-08-10).
#    `getaddrinfo("localhost")` 가 `::1`(IPv6)을 먼저 주는데 위 바인딩 변경으로
#    IPv6 에는 아무도 안 듣는다 → OS TCP 재시도를 다 쓰고 IPv4 로 폴백하느라
#    **동기 접속 1회당 130초**(실측). 안 터지고 느려지기만 해서 안 걸린다.
#    앱은 `app/config.py:_normalize_dsn` 이 한 번 더 막지만(경고 로그를 남긴다)
#    `scripts/*` 는 이 값을 그대로 쓴다 — 여기서 맞춰 둔다.
#    ⚠ 컨테이너 안에서 돌릴 때는 서비스명(`postgres`·`redis`)을 쓴다. 이 경고는
#      호스트에서 루프백으로 붙을 때만 해당한다.
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD 와 같은 값>@127.0.0.1:5432/omnisite"
REDIS_URL="redis://:<REDIS_PASSWORD 와 같은 값>@127.0.0.1:6379/0"

# DB 접속 타임아웃(초). 명시하지 않으면 libpq 가 DB 부재를 260초(실측) 뒤에야 알린다 —
# "무한 대기"가 아니라 "느린 스크립트"로 보여서 진단이 어긋난다.
DB_CONNECT_TIMEOUT=10


# ------------------------------------------------------------------------------
# 3. LLM
# ------------------------------------------------------------------------------
# 감리 판정(gpt-4o) · 시설 파라미터/지목(gpt-4o-mini) · 배제반경 검색에 공통 사용.
# 용도별 모델 지정은 app/config.py 에 있다.
# 없으면 RuntimeError. (픽스처 모드 mode="fixture" 는 LLM 을 안 부르므로 돈다)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ------------------------------------------------------------------------------
# 4. 지오코딩 — 🔴 브이월드 키는 이름이 둘이다
# ------------------------------------------------------------------------------
# 코드 두 갈래가 서로 다른 이름으로 읽는다. 같은 키 값을 두 번 적어야 한다.
# 한쪽만 채우면 나머지 갈래가 조용히 실패한다.
#
#   VWORLD_KEY      config.py:32  → gam2_audit_ops_catalog  (파이프라인 STEP2 지오코딩)
#   VWORLD_API_KEY  config.py:315 → app/utils/geocoder.py   (서버 쪽 지오코더)
#
# 발급: https://www.vworld.kr/dev/v4dv_20_apikey_s001.do
VWORLD_KEY=
VWORLD_API_KEY=

# 카카오 로컬 REST API (결측 주소 지오코딩 폴백). 없으면 폴백 없음.
# 발급: https://developers.kakao.com
KAKAO_REST_API_KEY=


# ------------------------------------------------------------------------------
# 5. 조례·법령 자동 취득
# ------------------------------------------------------------------------------
# 법제처 국가법령정보 OC값 (조례 목록·본문 조회 주력).
#   OC = 발급 시 등록한 이메일의 아이디 부분 (예: hong@korea.kr → OC=hong)
# 없으면 mock 폴백(개발용 고정값)으로 내려간다 — 값은 나오지만 실제 법령이 아니다.
# 발급: https://open.law.go.kr/LSO/openApi/openApiManual.do
LAW_GO_KR_OC=

# 공공데이터포털 인증키. config.py:33 에서 읽지만 현재 사용처 없음(자리 유지).
# 발급: https://www.data.go.kr
DATA_GO_KR_KEY=


# ------------------------------------------------------------------------------
# 6. 보안 / JWT
# ------------------------------------------------------------------------------
# 🔴 SECRET_KEY 는 **기본값이 없다. 없으면 기동이 실패한다**(2026-08-10).
#    JWT 서명키라 저장소에 박힌 값을 쓰면 아무나 토큰을 위조할 수 있다 —
#    DATABASE_URL 과 같은 이유로 각자 무작위로 만든다. 아래 예시값을 그대로 쓰지 말 것.
#    생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM="HS256"

# 듀얼 토큰(PR #221). Access 는 짧게, Refresh 로 갱신한다.
# 예전 단일 토큰은 10080분(1주일)이었다 — 탈취되면 1주일간 무방비였다.
#
# 🔴 **access 수명은 로그인 유지 시간이 아니다.** 유지는 refresh(7일)가 정하고,
#    access 가 만료되면 프런트가 `/auth/refresh` 로 조용히 갈아끼운다. 여기서
#    정하는 건 **새어나간 토큰이 사는 시간**이다(취소할 방법이 없다).
# 🔴 이 파일은 예시일 뿐이고 **`.env` 는 리포에 없다.** PR 이 기본값을 바꿔도
#    돌아가는 설치에는 안 따라온다 — 실제로 `.env` 만 10080 으로 남아 있어서
#    access·refresh 수명이 같아졌던 적이 있다(2026-08-11 `check_auth_real_db.py`
#    가 잡았다). 값을 바꿀 땐 `.env`·`app/config.py`·대조기 설계값을 **같이** 본다.
# PR #221 은 15분이었으나 60분으로 올렸다(2026-08-11) — 사유는 app/config.py 주석.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------------------------
# 7. 선택 — 실행 환경 덮어쓰기 (없으면 app/config.py 기본값)
# ------------------------------------------------------------------------------
# 서버 파이썬과 파이프라인 파이썬이 다를 때만 지정.
# 파이프라인은 geopandas·shapely·pyarrow 를 요구한다.
# OMNISITE_PYTHON=C:\Python314\python.exe

# 일부 SHP 의 .shx 누락 대응. 없으면 지적도 로드가 실패할 수 있다.
# SHAPE_RESTORE_SHX=YES

# 지오코딩 처리량. 브이월드 초당 제한이 미문서화라 실측으로 정한 값이다.
# GEOCODE_RATE_LIMIT=10
# GEOCODE_MAX_WORKERS=6

# 🔴 OMNISITE_DATA_ROOT 는 여기서 바꾸지 말 것.
#    바꾸면 SEARCH_CACHE_DIR 까지 갈라져 캐시 이득이 0 이 되고 LLM 호출이 폭증한다.
#    run 격리는 OMNISITE_STEP1~4_DIR 로만 한다(러너가 자동으로 넣는다).
