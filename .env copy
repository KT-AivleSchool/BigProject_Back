# ============================================================
# OmniSite — 비밀값(.env)
# ============================================================
# 사용법:
#   1) 이 파일을 복사해서 같은 폴더에 ".env" 로 저장
#   2) 아래 값을 본인 키로 채움
#   3) .env 는 절대 git 에 올리지 말 것 (.gitignore 에 포함)
#
# 코드에서는 os.environ 으로 읽힘 (config.py 가 처리).
# 모델명 등 비밀 아닌 설정은 config.py 에 있음.
# ============================================================

# ── OpenAI ─────────────────────────────────────────────
# 감리 판정·시설 확정·배제반경 서핑에 공통 사용(모델은 config.py 에서 용도별 지정).
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 지오코딩 ───────────────────────────────────────────
# 브이월드 인증키 (주소→좌표, 좌표→행정동 폴백).
# 발급: https://www.vworld.kr/dev/v4dv_20_apikey_s001.do
VWORLD_KEY=


# ── 조례 자동 취득 ─────────────────────────────────────
# 법제처 국가법령정보 OC값 (조례 목록·본문 조회 주력).
#   OC = 발급 시 등록한 이메일의 아이디 부분 (예: hong@korea.kr → OC=hong)
# 발급: https://open.law.go.kr/LSO/openApi/openApiManual.do
LAW_GO_KR_OC=

# ── 공공데이터포털 ─────────────────────────────────────
# 공공데이터포털 인증키 (E1 민원 수집, 조례 목록 백업 등).
# 발급: https://www.data.go.kr
DATA_GO_KR_KEY=